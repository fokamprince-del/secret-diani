// Schéma Prisma — « Les Secrets de Diani »
// Conventions (voir docs/DECISIONS.md) :
//   - modèles en anglais (PascalCase), tables/colonnes en snake_case via @@map/@map ;
//   - clés primaires UUID v7 générées par le client Prisma ;
//   - montants en centimes (Int), devise EUR ;
//   - created_at / updated_at partout, deleted_at là où l'historique compte.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Paramètres du site modifiables sans déploiement (textes, drapeaux de fonctionnalités…).
model AppSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

// =============================================================================
// Phase 2 — Authentification et comptes
// =============================================================================

enum UserRole {
  client
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  locked
  deleted

  @@map("user_status")
}

/// MLD : utilisateur. E-mail unique insensible à la casse (citext).
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @unique @db.Citext
  /// Argon2id. NULL après anonymisation (compte supprimé).
  passwordHash       String?    @map("password_hash") @db.VarChar(255)
  role               UserRole   @default(client)
  status             UserStatus @default(active)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  firstName          String?    @map("first_name") @db.VarChar(100)
  lastName           String?    @map("last_name") @db.VarChar(100)
  phone              String?    @db.VarChar(20)
  /// Secret TOTP chiffré (AES-256-GCM, clé hors base).
  totpSecretEnc      String?    @map("totp_secret_enc") @db.VarChar(255)
  totpEnabledAt      DateTime?  @map("totp_enabled_at") @db.Timestamptz(3)
  /// Dernier pas TOTP accepté (anti-rejeu d'un même code).
  totpLastStep       Int?       @map("totp_last_step")
  termsAcceptedAt    DateTime   @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion       String     @map("terms_version") @db.VarChar(20)
  marketingConsentAt DateTime?  @map("marketing_consent_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  lockedAt           DateTime?  @map("locked_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)

  sessions    Session[]
  tokens      UserToken[]
  backupCodes MfaBackupCode[]
  addresses   Address[]

  @@index([role])
  @@index([status, createdAt])
  @@map("users")
}

/// MLD : session — une session = une famille de rotation de refresh tokens (un appareil).
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Session ouverte après validation du second facteur (obligatoire pour les administrateurs).
  mfa           Boolean   @default(false)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  /// IP tronquée (/24 en IPv4, /48 en IPv6) : jamais l'adresse complète.
  ipTruncated   String?   @map("ip_truncated") @db.VarChar(64)
  /// Expiration absolue, quelle que soit l'activité.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// MLD : refresh_token — jeton opaque, seule son empreinte SHA-256 est stockée. Usage unique.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum UserTokenPurpose {
  email_verification
  password_reset
  email_change

  @@map("user_token_purpose")
}

/// Jetons à usage unique envoyés par e-mail (vérification, réinitialisation, changement d'e-mail).
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  /// Nouvelle adresse, pour un changement d'e-mail uniquement.
  newEmail  String?          @map("new_email") @db.Citext
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// Codes de secours 2FA (usage unique, stockés sous forme d'empreinte HMAC).
model MfaBackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_backup_codes")
}

enum AddressType {
  shipping
  billing

  @@map("address_type")
}

/// MLD : adresse (livraison / facturation).
model Address {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  type       AddressType
  label      String?     @db.VarChar(50)
  firstName  String      @map("first_name") @db.VarChar(100)
  lastName   String      @map("last_name") @db.VarChar(100)
  line1      String      @db.VarChar(200)
  line2      String?     @db.VarChar(200)
  postalCode String      @map("postal_code") @db.VarChar(10)
  city       String      @db.VarChar(100)
  /// Code pays ISO 3166-1 alpha-2.
  country    String      @default("FR") @db.Char(2)
  phone      String?     @db.VarChar(20)
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// MLD : audit_log — journal immuable (UPDATE interdit, DELETE seulement après la durée de conservation).
/// Aucune clé étrangère : l'entrée survit à l'anonymisation de l'auteur. Aucune donnée personnelle.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String?  @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?
  ipTruncated String?  @map("ip_truncated") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Phase 3 — Contenus éditoriaux et médias
// =============================================================================

enum MediaKind {
  image
  document

  @@map("media_kind")
}

enum MediaStatus {
  /// Emplacement réservé, fichier pas encore reçu (upload par URL pré-signée).
  pending
  /// Fichier reçu, contrôles et variantes en cours (worker).
  processing
  ready
  /// Refusé par les contrôles (type réel, taille, antivirus) : voir rejection_reason.
  rejected

  @@map("media_status")
}

/// MLD : media. Fichiers renommés aléatoirement ; images ré-encodées (WebP/AVIF, sans EXIF).
model Media {
  id              String      @id @default(uuid(7)) @db.Uuid
  kind            MediaKind
  status          MediaStatus @default(pending)
  /// Nom d'origine, conservé pour l'administration uniquement (jamais utilisé comme chemin).
  originalName    String      @map("original_name") @db.VarChar(255)
  /// Type MIME vérifié par les octets magiques (pas celui déclaré par le navigateur).
  mimeType        String?     @map("mime_type") @db.VarChar(100)
  sizeBytes       Int?        @map("size_bytes")
  sha256          String?     @db.Char(64)
  /// Clé de l'original dans le stockage privé (supprimé après traitement pour les images).
  storageKey      String      @unique @map("storage_key") @db.VarChar(255)
  width           Int?
  height          Int?
  /// Texte alternatif par défaut (vide = image décorative).
  alt             String      @default("") @db.VarChar(300)
  /// Variantes publiques : [{ format, width, height, key, url, bytes }].
  variants        Json        @default("[]")
  /// Aperçu flou minuscule (data URI) pour le chargement progressif.
  blurDataUrl     String?     @map("blur_data_url") @db.VarChar(2000)
  /// Résultat de l'analyse antivirus : clean | skipped (antivirus non configuré).
  scanResult      String?     @map("scan_result") @db.VarChar(20)
  rejectionReason String?     @map("rejection_reason") @db.VarChar(300)
  uploadedById    String?     @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)

  articleCovers  Article[]
  cateringImages CateringProductImage[]

  @@index([kind, status, createdAt])
  @@index([deletedAt])
  @@map("media")
}

model ArticleCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  articles Article[]

  @@index([position])
  @@map("article_categories")
}

enum ArticleStatus {
  draft
  published

  @@map("article_status")
}

/// MLD : article (Conseils & astuces). « Programmé » = publié avec une date de publication future.
model Article {
  id                String        @id @default(uuid(7)) @db.Uuid
  slug              String        @unique @db.VarChar(160)
  /// Anciens slugs d'un article déjà publié (redirection permanente, liens SEO conservés).
  previousSlugs     String[]      @default([]) @map("previous_slugs") @db.VarChar(160)
  title             String        @db.VarChar(200)
  excerpt           String        @db.VarChar(500)
  /// Source Markdown (le HTML brut y est désactivé).
  bodyMarkdown      String        @map("body_markdown")
  /// HTML rendu côté serveur et assaini (liste blanche de balises).
  bodyHtml          String        @map("body_html")
  /// Table des matières : [{ id, title, level }].
  toc               Json          @default("[]")
  readingMinutes    Int           @default(1) @map("reading_minutes")
  status            ArticleStatus @default(draft)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  seoTitle          String?       @map("seo_title") @db.VarChar(70)
  seoDescription    String?       @map("seo_description") @db.VarChar(160)
  coverMediaId      String?       @map("cover_media_id") @db.Uuid
  coverAlt          String        @default("") @map("cover_alt") @db.VarChar(300)
  categoryId        String?       @map("category_id") @db.Uuid
  /// Formation mise en avant en fin d'article (slug, relié en phase 7).
  relatedCourseSlug String?       @map("related_course_slug") @db.VarChar(160)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)

  coverMedia Media?           @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([coverMediaId])
  @@index([deletedAt])
  @@index([previousSlugs], map: "articles_previous_slugs_idx", type: Gin)
  @@map("articles")
}

/// MLD : page_statique (À propos, mentions légales, CGV, confidentialité…).
model StaticPage {
  id             String   @id @default(uuid(7)) @db.Uuid
  slug           String   @unique @db.VarChar(120)
  title          String   @db.VarChar(200)
  bodyMarkdown   String   @map("body_markdown")
  bodyHtml       String   @map("body_html")
  toc            Json     @default("[]")
  published      Boolean  @default(false)
  seoTitle       String?  @map("seo_title") @db.VarChar(70)
  seoDescription String?  @map("seo_description") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("static_pages")
}

enum FaqCategory {
  general
  traiteur
  formations
  boutique
  livraison
  paiement
  retours

  @@map("faq_category")
}

/// MLD : faq — ordonnable (position), par catégorie.
model Faq {
  id             String      @id @default(uuid(7)) @db.Uuid
  category       FaqCategory @default(general)
  question       String      @db.VarChar(300)
  answerMarkdown String      @map("answer_markdown")
  answerHtml     String      @map("answer_html")
  position       Int         @default(0)
  published      Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category, position])
  @@map("faqs")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

/// MLD : avis — traiteur uniquement, saisis par l'administration avec leur provenance, modérés.
model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Nom affiché tel qu'autorisé par la cliente (ex. « Awa D. »).
  authorName       String       @map("author_name") @db.VarChar(80)
  rating           Int
  content          String       @db.VarChar(2000)
  /// Contexte affiché (ex. « Anniversaire, 40 personnes »).
  occasion         String?      @db.VarChar(120)
  receivedOn       DateTime     @map("received_on") @db.Date
  /// Provenance interne, jamais publiée (ex. « message WhatsApp du 12/09 ») : aucun avis inventé.
  sourceNote       String       @map("source_note") @db.VarChar(300)
  /// La cliente a accepté la publication (obligatoire).
  consentConfirmed Boolean      @map("consent_confirmed")
  status           ReviewStatus @default(pending)
  position         Int          @default(0)
  moderatedById    String?      @map("moderated_by_id") @db.Uuid
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(3)
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, position])
  @@map("reviews")
}

// =============================================================================
// Phase 4 — Traiteur
// =============================================================================

/// Comportement d'affichage d'une catégorie (plateaux, mini bouchées à la carte, layer cakes).
enum CateringKind {
  platter
  a_la_carte
  layer_cake

  @@map("catering_kind")
}

/// MLD : categorie_traiteur.
model CateringCategory {
  id          String       @id @default(uuid(7)) @db.Uuid
  slug        String       @unique @db.VarChar(120)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  kind        CateringKind
  position    Int          @default(0)
  visible     Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  products CateringProduct[]

  @@index([position])
  @@map("catering_categories")
}

/// MLD : produit_traiteur (plateau, à la carte ou layer cake selon la catégorie).
model CateringProduct {
  id             String    @id @default(uuid(7)) @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  slug           String    @unique @db.VarChar(160)
  name           String    @db.VarChar(160)
  description    String?   @db.VarChar(2000)
  /// Composition affichée : [{ label, quantity }] (ex. 5 mini burgers).
  composition    Json      @default("[]")
  /// Nombre maximal de parfums au choix (0 = pas de parfum ; layer cakes : plusieurs).
  maxFlavours    Int       @default(0) @map("max_flavours")
  position       Int       @default(0)
  visible        Boolean   @default(true)
  seoTitle       String?   @map("seo_title") @db.VarChar(70)
  seoDescription String?   @map("seo_description") @db.VarChar(160)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Suppression logique : les demandes passées gardent leurs libellés figés.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  category CateringCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants CateringVariant[]
  flavours CateringProductFlavour[]
  images   CateringProductImage[]

  @@index([categoryId, position])
  @@index([deletedAt])
  @@map("catering_products")
}

/// MLD : variante_traiteur (taille ou conditionnement, avec son prix).
model CateringVariant {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  /// Libellé affiché (ex. « 6–8 parts », « Boîte de 10 »).
  label       String   @db.VarChar(80)
  priceCents  Int      @map("price_cents")
  /// Nombre de parts indicatif (layer cakes), pour orienter le choix.
  servingsMin Int?     @map("servings_min")
  servingsMax Int?     @map("servings_max")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product CateringProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("catering_variants")
}

/// MLD : parfum.
model CateringFlavour {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(120)
  name      String   @db.VarChar(120)
  position  Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products CateringProductFlavour[]

  @@index([position])
  @@map("catering_flavours")
}

/// MLD : produit_parfum (parfums proposés pour un produit).
model CateringProductFlavour {
  productId String @map("product_id") @db.Uuid
  flavourId String @map("flavour_id") @db.Uuid

  product CateringProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavour CateringFlavour @relation(fields: [flavourId], references: [id], onDelete: Cascade)

  @@id([productId, flavourId])
  @@index([flavourId])
  @@map("catering_product_flavours")
}

/// Galerie d'un produit (la première image sert de vignette).
model CateringProductImage {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  alt       String @default("") @db.VarChar(300)
  position  Int    @default(0)

  product CateringProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([mediaId])
  @@map("catering_product_images")
}

enum CateringRequestStatus {
  new
  contacted
  deposit_received
  confirmed
  delivered
  cancelled

  @@map("catering_request_status")
}

enum CateringFulfilment {
  pickup
  delivery

  @@map("catering_fulfilment")
}

enum CateringRequestSource {
  /// Formulaire « Demande personnalisée » (parcours par défaut).
  form
  /// Commande en ligne (parcours avancé, drapeau CATERING_ONLINE_ORDERING).
  online
  /// Saisie par l'administration (demande reçue par WhatsApp, téléphone…).
  admin

  @@map("catering_request_source")
}

/// MLD : demande_traiteur. Données personnelles anonymisées après la durée de conservation.
model CateringRequest {
  id                  String                @id @default(uuid(7)) @db.Uuid
  /// Numéro lisible (affiché « TR-000042 »).
  number              Int                   @unique @default(autoincrement())
  source              CateringRequestSource @default(form)
  status              CateringRequestStatus @default(new)
  firstName           String                @map("first_name") @db.VarChar(100)
  lastName            String?               @map("last_name") @db.VarChar(100)
  email               String                @db.Citext
  phone               String?               @db.VarChar(20)
  eventDate           DateTime              @map("event_date") @db.Date
  guestCount          Int?                  @map("guest_count")
  fulfilment          CateringFulfilment?
  /// Ville ou adresse de livraison (texte libre, livraison seulement).
  deliveryAddress     String?               @map("delivery_address") @db.VarChar(300)
  message             String?               @db.VarChar(3000)
  /// Total estimé à partir de la sélection (prix serveur au moment de la demande).
  estimatedTotalCents Int?                  @map("estimated_total_cents")
  /// Total convenu avec la cliente (fixé par l'administration) ; base du calcul de l'acompte.
  agreedTotalCents    Int?                  @map("agreed_total_cents")
  depositCents        Int?                  @map("deposit_cents")
  depositReceivedAt   DateTime?             @map("deposit_received_at") @db.Timestamptz(3)
  /// Moyen de réception de l'acompte (virement, espèces, PayPal…), texte court.
  depositMethod       String?               @map("deposit_method") @db.VarChar(50)
  confirmedAt         DateTime?             @map("confirmed_at") @db.Timestamptz(3)
  deliveredAt         DateTime?             @map("delivered_at") @db.Timestamptz(3)
  cancelledAt         DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason  String?               @map("cancellation_reason") @db.VarChar(500)
  /// Notes internes (jamais visibles de la cliente).
  internalNotes       String?               @map("internal_notes") @db.VarChar(5000)
  slotId              String?               @map("slot_id") @db.Uuid
  anonymizedAt        DateTime?             @map("anonymized_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  items  CateringRequestItem[]
  events CateringRequestEvent[]
  slot   CateringSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([status, eventDate])
  @@index([email])
  @@index([eventDate])
  @@index([slotId])
  @@index([updatedAt])
  @@map("catering_requests")
}

/// Ligne de sélection d'une demande. Libellés et prix figés au moment de la demande.
model CateringRequestItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(160)
  variantLabel   String   @map("variant_label") @db.VarChar(80)
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  /// Noms des parfums choisis (figés).
  flavours       String[] @default([]) @db.VarChar(120)
  position       Int      @default(0)

  request CateringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("catering_request_items")
}

/// Historique d'une demande (statut, acompte) : qui, quoi, quand.
model CateringRequestEvent {
  id         String                 @id @default(uuid(7)) @db.Uuid
  requestId  String                 @map("request_id") @db.Uuid
  fromStatus CateringRequestStatus? @map("from_status")
  toStatus   CateringRequestStatus  @map("to_status")
  actorId    String?                @map("actor_id") @db.Uuid
  note       String?                @db.VarChar(500)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  request CateringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("catering_request_events")
}

/// Créneau de retrait ou de livraison (parcours avancé, désactivé par défaut).
model CateringSlot {
  id         String             @id @default(uuid(7)) @db.Uuid
  fulfilment CateringFulfilment
  startsAt   DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime           @map("ends_at") @db.Timestamptz(3)
  /// Nombre maximal de commandes sur le créneau.
  capacity   Int
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests CateringRequest[]

  @@index([fulfilment, startsAt])
  @@map("catering_slots")
}
