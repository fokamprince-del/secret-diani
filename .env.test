# Configuration des tests e2e — valeurs locales sans secret réel (infrastructure docker-compose.test.yml).
NODE_ENV=test
PUBLIC_SITE_URL=http://localhost:5173
DATABASE_URL=postgresql://diani:diani_test_password@127.0.0.1:55432/diani_test?schema=public&connection_limit=5
REDIS_URL=redis://127.0.0.1:56379
LOG_LEVEL=silent
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=1000
# Les tests simulent des clients distincts via X-Forwarded-For (limitation de débit par IP).
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=test-only-jwt-secret-0123456789-abcdefghijkl
FIELD_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=tmp/mails-test
