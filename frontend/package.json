{
  "name": "les-secrets-de-diani-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Site Next.js « Les Secrets de Diani » : traiteur, formations, boutique et conseils.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --port 5173",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "build:e2e": "node scripts/with-mock-api.mjs npm run build",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:generate": "openapi-typescript openapi/openapi.json -o lib/api/schema.d.ts && prettier --write lib/api/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- lib/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "mock-api": "node tests/mock-api/server.mts",
    "test:a11y": "playwright test --grep @a11y",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.2",
    "hls.js": "1.7.3",
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "server-only": "0.0.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
