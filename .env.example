# =============================================================================
# Les Secrets de Diani — variables d'environnement
# Copier en `.env` pour le développement local. Ne JAMAIS commiter de valeur réelle.
# L'application refuse de démarrer si une variable obligatoire manque ou est invalide.
# =============================================================================

# --- Application ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
# URL publique du site (frontend). Obligatoire. En production : https uniquement.
PUBLIC_SITE_URL=http://localhost:5173
# Origines autorisées par CORS, séparées par des virgules (défaut : PUBLIC_SITE_URL).
# CORS_ORIGINS=https://lessecretsdediani.fr,https://www.lessecretsdediani.fr

# --- Base de données (PostgreSQL 16) -----------------------------------------------
# Obligatoire. connection_limit = taille du pool par instance ; pool_timeout en secondes.
# En développement : rôle propriétaire (simplicité, `make migrate` utilise la même URL).
# En test et en production : rôle à privilèges minimaux `diani_app` (voir RUNBOOK › rôles).
DATABASE_URL=postgresql://diani:diani_dev_password@127.0.0.1:5432/diani?schema=public&connection_limit=10&pool_timeout=10

# --- Redis (cache, limitation de débit, files BullMQ) ----------------------------------
# Obligatoire. rediss:// pour une connexion TLS.
REDIS_URL=redis://127.0.0.1:6379

# --- Journalisation et supervision ---------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Journaux lisibles en local (true) ; toujours false en conteneur et en production (JSON).
LOG_PRETTY=true
# Facultatif : active Sentry si renseigné.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# Proportion des transactions tracées (0 à 1).
SENTRY_TRACES_SAMPLE_RATE=0

# --- HTTP ----------------------------------------------------------------------
# Documentation Swagger sur /api/docs (désactivée par défaut ; refusée en production : l'API ne démarre pas).
SWAGGER_ENABLED=true
# Nombre de proxys de confiance devant l'API (production : 2 = Cloudflare + Traefik).
TRUST_PROXY_HOPS=0
# Taille maximale d'un corps de requête JSON (ex. 100kb, 1mb).
BODY_LIMIT=100kb
# Durée maximale de traitement d'une requête (ms).
HTTP_REQUEST_TIMEOUT_MS=30000

# --- Limitation de débit globale (par IP) ----------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120

# --- Fonctionnalités -------------------------------------------------------------
# Parcours traiteur avancé (panier, créneaux, acompte en ligne) : désactivé.
CATERING_ONLINE_ORDERING=false

# --- Authentification (phase 2) ---------------------------------------------------
# Secret de signature des jetons d'accès JWT (HS256). Obligatoire, 32 caractères minimum.
# Générer : openssl rand -base64 48
JWT_ACCESS_SECRET=
# Ancien secret, accepté en vérification seulement pendant une rotation (voir RUNBOOK).
# JWT_ACCESS_SECRET_PREVIOUS=
# Clé de chiffrement des champs sensibles (secrets 2FA) : 32 octets en base64. Obligatoire.
# Générer : openssl rand -base64 32 — à conserver HORS de la base et de ses sauvegardes.
FIELD_ENCRYPTION_KEY=
# Ancienne clé, utilisée en déchiffrement seulement pendant une rotation (voir RUNBOOK).
# FIELD_ENCRYPTION_KEY_PREVIOUS=
# Version des CGU / politique de confidentialité acceptée à l'inscription.
TERMS_VERSION=2026-10

# --- E-mails transactionnels -----------------------------------------------------------
# resend (obligatoire en production) | outbox (développement : e-mails écrits dans MAIL_OUTBOX_DIR)
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=tmp/mails
MAIL_FROM="Les Secrets de Diani <ne-pas-repondre@lessecretsdediani.fr>"
# MAIL_REPLY_TO=contact@lessecretsdediani.fr
# Obligatoire si MAIL_TRANSPORT=resend.
# RESEND_API_KEY=

# --- Stockage objets compatible S3 (phase 3) -----------------------------------------
# Production : OVH Object Storage (ex. https://s3.gra.io.cloud.ovh.net, région gra).
# Développement : SeaweedFS lancé par docker compose (http://localhost:8333).
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=gra
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev-secret
# Bucket privé : originaux en cours de traitement, documents PDF (URL signées uniquement).
S3_BUCKET_PRIVATE=diani-private
# Bucket public : variantes d'images ré-encodées, servies par le CDN.
S3_BUCKET_PUBLIC=diani-public
S3_FORCE_PATH_STYLE=true
# Développement uniquement (interdit en production) : crée les buckets au démarrage.
S3_AUTO_CREATE_BUCKETS=true
# URL publique du bucket public, ou du CDN devant lui (production : https://medias.lessecretsdediani.fr).
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/diani-public

# --- Antivirus (facultatif, recommandé en production) --------------------------------
# Démon clamd joignable en TCP (voir RUNBOOK). Sans lui, les fichiers ne sont pas analysés.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# --- Contenus ----------------------------------------------------------------------
# Durée du cache Redis des contenus publics (secondes, 0 = désactivé).
CONTENT_CACHE_TTL_SECONDS=300
# Revalidation des pages du frontend (Next.js) après une modification de contenu.
# FRONTEND_REVALIDATE_URL=https://lessecretsdediani.fr/api/revalidate
# FRONTEND_REVALIDATE_SECRET=   (32 caractères minimum, partagé avec le frontend)

# --- Phases suivantes (ajoutées et validées au fil des phases) ---------------------------
# Phase 6 : STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET
# Phase 7 : BUNNY_STREAM_LIBRARY_ID, BUNNY_STREAM_TOKEN_KEY
# Phase 8 : TURNSTILE_SECRET_KEY
