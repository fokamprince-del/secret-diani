# =============================================================================
# Les Secrets de Diani — frontend (Next.js)
# Copier en `.env.local` pour le développement. Ne JAMAIS commiter de valeur réelle.
# Seules les variables NEXT_PUBLIC_* sont envoyées au navigateur : aucun secret dedans.
# =============================================================================

# --- Public (navigateur) ---------------------------------------------------------
# URL publique du site (canoniques, Open Graph, sitemap). https en production.
NEXT_PUBLIC_SITE_URL=http://localhost:5173
# URL publique de l'API NestJS (origine seule, sans /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:3000
# Origine publique des médias (images optimisées servies par le stockage S3 / CDN).
NEXT_PUBLIC_MEDIA_URL=http://localhost:8333
# Mesure d'audience (Plausible), chargée uniquement après consentement. Vide = désactivée.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# --- Serveur uniquement ------------------------------------------------------------
# URL de l'API vue depuis le serveur Next (réseau Docker interne). Défaut : NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://api:3000
# Secret partagé avec l'API (FRONTEND_REVALIDATE_SECRET) pour POST /api/revalidate. 32 caractères min.
REVALIDATE_SECRET=
