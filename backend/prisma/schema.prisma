// Schéma Prisma — « Les Secrets de Diani »
// Conventions (voir docs/DECISIONS.md) :
//   - modèles en anglais (PascalCase), tables/colonnes en snake_case via @@map/@map ;
//   - clés primaires UUID v7 générées par le client Prisma ;
//   - montants en centimes (Int), devise EUR ;
//   - created_at / updated_at partout, deleted_at là où l'historique compte.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Paramètres du site modifiables sans déploiement (textes, drapeaux de fonctionnalités…).
model AppSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_settings")
}

// =============================================================================
// Phase 2 — Authentification et comptes
// =============================================================================

enum UserRole {
  client
  admin

  @@map("user_role")
}

enum UserStatus {
  active
  locked
  deleted

  @@map("user_status")
}

/// MLD : utilisateur. E-mail unique insensible à la casse (citext).
model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  email              String     @unique @db.Citext
  /// Argon2id. NULL après anonymisation (compte supprimé).
  passwordHash       String?    @map("password_hash") @db.VarChar(255)
  role               UserRole   @default(client)
  status             UserStatus @default(active)
  emailVerifiedAt    DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// Identifiant stable du compte Google (« sub » OpenID Connect) : connexion avec Google.
  googleSubject      String?    @unique @map("google_subject") @db.VarChar(255)
  firstName          String?    @map("first_name") @db.VarChar(100)
  lastName           String?    @map("last_name") @db.VarChar(100)
  phone              String?    @db.VarChar(20)
  /// Secret TOTP chiffré (AES-256-GCM, clé hors base).
  totpSecretEnc      String?    @map("totp_secret_enc") @db.VarChar(255)
  totpEnabledAt      DateTime?  @map("totp_enabled_at") @db.Timestamptz(3)
  /// Dernier pas TOTP accepté (anti-rejeu d'un même code).
  totpLastStep       Int?       @map("totp_last_step")
  termsAcceptedAt    DateTime   @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion       String     @map("terms_version") @db.VarChar(20)
  marketingConsentAt DateTime?  @map("marketing_consent_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  lockedAt           DateTime?  @map("locked_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(3)

  sessions       Session[]
  tokens         UserToken[]
  backupCodes    MfaBackupCode[]
  addresses      Address[]
  cart           ShopCart?
  orders         Order[]
  courseAccesses CourseAccess[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
  callRequests   CallRequest[]

  @@index([role])
  @@index([status, createdAt])
  @@map("users")
}

/// MLD : session — une session = une famille de rotation de refresh tokens (un appareil).
model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Session ouverte après validation du second facteur (obligatoire pour les administrateurs).
  mfa           Boolean   @default(false)
  userAgent     String?   @map("user_agent") @db.VarChar(255)
  /// IP tronquée (/24 en IPv4, /48 en IPv6) : jamais l'adresse complète.
  ipTruncated   String?   @map("ip_truncated") @db.VarChar(64)
  /// Expiration absolue, quelle que soit l'activité.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// MLD : refresh_token — jeton opaque, seule son empreinte SHA-256 est stockée. Usage unique.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum UserTokenPurpose {
  email_verification
  password_reset
  email_change

  @@map("user_token_purpose")
}

/// Jetons à usage unique envoyés par e-mail (vérification, réinitialisation, changement d'e-mail).
model UserToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  /// Nouvelle adresse, pour un changement d'e-mail uniquement.
  newEmail  String?          @map("new_email") @db.Citext
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// Codes de secours 2FA (usage unique, stockés sous forme d'empreinte HMAC).
model MfaBackupCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_backup_codes")
}

enum AddressType {
  shipping
  billing

  @@map("address_type")
}

/// MLD : adresse (livraison / facturation).
model Address {
  id         String      @id @default(uuid(7)) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  type       AddressType
  label      String?     @db.VarChar(50)
  firstName  String      @map("first_name") @db.VarChar(100)
  lastName   String      @map("last_name") @db.VarChar(100)
  line1      String      @db.VarChar(200)
  line2      String?     @db.VarChar(200)
  postalCode String      @map("postal_code") @db.VarChar(10)
  city       String      @db.VarChar(100)
  /// Code pays ISO 3166-1 alpha-2.
  country    String      @default("FR") @db.Char(2)
  phone      String?     @db.VarChar(20)
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

/// MLD : audit_log — journal immuable (UPDATE interdit, DELETE seulement après la durée de conservation).
/// Aucune clé étrangère : l'entrée survit à l'anonymisation de l'auteur. Aucune donnée personnelle.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(80)
  targetType  String?  @map("target_type") @db.VarChar(50)
  targetId    String?  @map("target_id") @db.Uuid
  metadata    Json?
  ipTruncated String?  @map("ip_truncated") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Phase 3 — Contenus éditoriaux et médias
// =============================================================================

enum MediaKind {
  image
  document

  @@map("media_kind")
}

enum MediaStatus {
  /// Emplacement réservé, fichier pas encore reçu (upload par URL pré-signée).
  pending
  /// Fichier reçu, contrôles et variantes en cours (worker).
  processing
  ready
  /// Refusé par les contrôles (type réel, taille, antivirus) : voir rejection_reason.
  rejected

  @@map("media_status")
}

/// MLD : media. Fichiers renommés aléatoirement ; images ré-encodées (WebP/AVIF, sans EXIF).
model Media {
  id              String      @id @default(uuid(7)) @db.Uuid
  kind            MediaKind
  status          MediaStatus @default(pending)
  /// Nom d'origine, conservé pour l'administration uniquement (jamais utilisé comme chemin).
  originalName    String      @map("original_name") @db.VarChar(255)
  /// Type MIME vérifié par les octets magiques (pas celui déclaré par le navigateur).
  mimeType        String?     @map("mime_type") @db.VarChar(100)
  sizeBytes       Int?        @map("size_bytes")
  sha256          String?     @db.Char(64)
  /// Clé de l'original dans le stockage privé (supprimé après traitement pour les images).
  storageKey      String      @unique @map("storage_key") @db.VarChar(255)
  width           Int?
  height          Int?
  /// Texte alternatif par défaut (vide = image décorative).
  alt             String      @default("") @db.VarChar(300)
  /// Variantes publiques : [{ format, width, height, key, url, bytes }].
  variants        Json        @default("[]")
  /// Aperçu flou minuscule (data URI) pour le chargement progressif.
  blurDataUrl     String?     @map("blur_data_url") @db.VarChar(2000)
  /// Résultat de l'analyse antivirus : clean | skipped (antivirus non configuré).
  scanResult      String?     @map("scan_result") @db.VarChar(20)
  rejectionReason String?     @map("rejection_reason") @db.VarChar(300)
  uploadedById    String?     @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?   @map("deleted_at") @db.Timestamptz(3)

  articleCovers   Article[]
  cateringImages  CateringProductImage[]
  shopImages      ShopProductImage[]
  courseCovers    Course[]
  lessonResources LessonResource[]

  @@index([kind, status, createdAt])
  @@index([deletedAt])
  @@map("media")
}

model ArticleCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  articles Article[]

  @@index([position])
  @@map("article_categories")
}

enum ArticleStatus {
  draft
  published

  @@map("article_status")
}

/// MLD : article (Conseils & astuces). « Programmé » = publié avec une date de publication future.
model Article {
  id                String        @id @default(uuid(7)) @db.Uuid
  slug              String        @unique @db.VarChar(160)
  /// Anciens slugs d'un article déjà publié (redirection permanente, liens SEO conservés).
  previousSlugs     String[]      @default([]) @map("previous_slugs") @db.VarChar(160)
  title             String        @db.VarChar(200)
  excerpt           String        @db.VarChar(500)
  /// Source Markdown (le HTML brut y est désactivé).
  bodyMarkdown      String        @map("body_markdown")
  /// HTML rendu côté serveur et assaini (liste blanche de balises).
  bodyHtml          String        @map("body_html")
  /// Table des matières : [{ id, title, level }].
  toc               Json          @default("[]")
  readingMinutes    Int           @default(1) @map("reading_minutes")
  status            ArticleStatus @default(draft)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(3)
  seoTitle          String?       @map("seo_title") @db.VarChar(70)
  seoDescription    String?       @map("seo_description") @db.VarChar(160)
  coverMediaId      String?       @map("cover_media_id") @db.Uuid
  coverAlt          String        @default("") @map("cover_alt") @db.VarChar(300)
  categoryId        String?       @map("category_id") @db.Uuid
  /// Formation mise en avant en fin d'article (slug, relié en phase 7).
  relatedCourseSlug String?       @map("related_course_slug") @db.VarChar(160)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)

  coverMedia Media?           @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([coverMediaId])
  @@index([deletedAt])
  @@index([previousSlugs], map: "articles_previous_slugs_idx", type: Gin)
  @@map("articles")
}

/// MLD : page_statique (À propos, mentions légales, CGV, confidentialité…).
model StaticPage {
  id             String   @id @default(uuid(7)) @db.Uuid
  slug           String   @unique @db.VarChar(120)
  title          String   @db.VarChar(200)
  bodyMarkdown   String   @map("body_markdown")
  bodyHtml       String   @map("body_html")
  toc            Json     @default("[]")
  published      Boolean  @default(false)
  seoTitle       String?  @map("seo_title") @db.VarChar(70)
  seoDescription String?  @map("seo_description") @db.VarChar(160)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("static_pages")
}

enum FaqCategory {
  general
  traiteur
  formations
  boutique
  livraison
  paiement
  retours

  @@map("faq_category")
}

/// MLD : faq — ordonnable (position), par catégorie.
model Faq {
  id             String      @id @default(uuid(7)) @db.Uuid
  category       FaqCategory @default(general)
  question       String      @db.VarChar(300)
  answerMarkdown String      @map("answer_markdown")
  answerHtml     String      @map("answer_html")
  position       Int         @default(0)
  published      Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([category, position])
  @@map("faqs")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

/// MLD : avis — traiteur uniquement, saisis par l'administration avec leur provenance, modérés.
model Review {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Nom affiché tel qu'autorisé par la cliente (ex. « Awa D. »).
  authorName       String       @map("author_name") @db.VarChar(80)
  rating           Int
  content          String       @db.VarChar(2000)
  /// Contexte affiché (ex. « Anniversaire, 40 personnes »).
  occasion         String?      @db.VarChar(120)
  receivedOn       DateTime     @map("received_on") @db.Date
  /// Provenance interne, jamais publiée (ex. « message WhatsApp du 12/09 ») : aucun avis inventé.
  sourceNote       String       @map("source_note") @db.VarChar(300)
  /// La cliente a accepté la publication (obligatoire).
  consentConfirmed Boolean      @map("consent_confirmed")
  status           ReviewStatus @default(pending)
  position         Int          @default(0)
  moderatedById    String?      @map("moderated_by_id") @db.Uuid
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(3)
  createdById      String?      @map("created_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, position])
  @@map("reviews")
}

// =============================================================================
// Phase 4 — Traiteur
// =============================================================================

/// Comportement d'affichage d'une catégorie (plateaux, mini bouchées à la carte, layer cakes).
enum CateringKind {
  platter
  a_la_carte
  layer_cake

  @@map("catering_kind")
}

/// MLD : categorie_traiteur.
model CateringCategory {
  id          String       @id @default(uuid(7)) @db.Uuid
  slug        String       @unique @db.VarChar(120)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(1000)
  kind        CateringKind
  position    Int          @default(0)
  visible     Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  products CateringProduct[]

  @@index([position])
  @@map("catering_categories")
}

/// MLD : produit_traiteur (plateau, à la carte ou layer cake selon la catégorie).
model CateringProduct {
  id             String    @id @default(uuid(7)) @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  slug           String    @unique @db.VarChar(160)
  name           String    @db.VarChar(160)
  description    String?   @db.VarChar(2000)
  /// Composition affichée : [{ label, quantity }] (ex. 5 mini burgers).
  composition    Json      @default("[]")
  /// Nombre maximal de parfums au choix (0 = pas de parfum ; layer cakes : plusieurs).
  maxFlavours    Int       @default(0) @map("max_flavours")
  position       Int       @default(0)
  visible        Boolean   @default(true)
  seoTitle       String?   @map("seo_title") @db.VarChar(70)
  seoDescription String?   @map("seo_description") @db.VarChar(160)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Suppression logique : les demandes passées gardent leurs libellés figés.
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  category CateringCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants CateringVariant[]
  flavours CateringProductFlavour[]
  images   CateringProductImage[]

  @@index([categoryId, position])
  @@index([deletedAt])
  @@map("catering_products")
}

/// MLD : variante_traiteur (taille ou conditionnement, avec son prix).
model CateringVariant {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  /// Libellé affiché (ex. « 6–8 parts », « Boîte de 10 »).
  label       String   @db.VarChar(80)
  priceCents  Int      @map("price_cents")
  /// Nombre de parts indicatif (layer cakes), pour orienter le choix.
  servingsMin Int?     @map("servings_min")
  servingsMax Int?     @map("servings_max")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product CateringProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("catering_variants")
}

/// MLD : parfum.
model CateringFlavour {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique @db.VarChar(120)
  name      String   @db.VarChar(120)
  position  Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products CateringProductFlavour[]

  @@index([position])
  @@map("catering_flavours")
}

/// MLD : produit_parfum (parfums proposés pour un produit).
model CateringProductFlavour {
  productId String @map("product_id") @db.Uuid
  flavourId String @map("flavour_id") @db.Uuid

  product CateringProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  flavour CateringFlavour @relation(fields: [flavourId], references: [id], onDelete: Cascade)

  @@id([productId, flavourId])
  @@index([flavourId])
  @@map("catering_product_flavours")
}

/// Galerie d'un produit (la première image sert de vignette).
model CateringProductImage {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  alt       String @default("") @db.VarChar(300)
  position  Int    @default(0)

  product CateringProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([mediaId])
  @@map("catering_product_images")
}

enum CateringRequestStatus {
  new
  contacted
  deposit_received
  confirmed
  delivered
  cancelled

  @@map("catering_request_status")
}

enum CateringFulfilment {
  pickup
  delivery

  @@map("catering_fulfilment")
}

enum CateringRequestSource {
  /// Formulaire « Demande personnalisée » (parcours par défaut).
  form
  /// Commande en ligne (parcours avancé, drapeau CATERING_ONLINE_ORDERING).
  online
  /// Saisie par l'administration (demande reçue par WhatsApp, téléphone…).
  admin

  @@map("catering_request_source")
}

/// MLD : demande_traiteur. Données personnelles anonymisées après la durée de conservation.
model CateringRequest {
  id                  String                @id @default(uuid(7)) @db.Uuid
  /// Numéro lisible (affiché « TR-000042 »).
  number              Int                   @unique @default(autoincrement())
  source              CateringRequestSource @default(form)
  status              CateringRequestStatus @default(new)
  firstName           String                @map("first_name") @db.VarChar(100)
  lastName            String?               @map("last_name") @db.VarChar(100)
  email               String                @db.Citext
  phone               String?               @db.VarChar(20)
  eventDate           DateTime              @map("event_date") @db.Date
  guestCount          Int?                  @map("guest_count")
  fulfilment          CateringFulfilment?
  /// Ville ou adresse de livraison (texte libre, livraison seulement).
  deliveryAddress     String?               @map("delivery_address") @db.VarChar(300)
  message             String?               @db.VarChar(3000)
  /// Total estimé à partir de la sélection (prix serveur au moment de la demande).
  estimatedTotalCents Int?                  @map("estimated_total_cents")
  /// Total convenu avec la cliente (fixé par l'administration) ; base du calcul de l'acompte.
  agreedTotalCents    Int?                  @map("agreed_total_cents")
  depositCents        Int?                  @map("deposit_cents")
  depositReceivedAt   DateTime?             @map("deposit_received_at") @db.Timestamptz(3)
  /// Moyen de réception de l'acompte (virement, espèces, PayPal…), texte court.
  depositMethod       String?               @map("deposit_method") @db.VarChar(50)
  confirmedAt         DateTime?             @map("confirmed_at") @db.Timestamptz(3)
  deliveredAt         DateTime?             @map("delivered_at") @db.Timestamptz(3)
  cancelledAt         DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason  String?               @map("cancellation_reason") @db.VarChar(500)
  /// Notes internes (jamais visibles de la cliente).
  internalNotes       String?               @map("internal_notes") @db.VarChar(5000)
  slotId              String?               @map("slot_id") @db.Uuid
  anonymizedAt        DateTime?             @map("anonymized_at") @db.Timestamptz(3)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  items  CateringRequestItem[]
  events CateringRequestEvent[]
  slot   CateringSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([status, eventDate])
  @@index([email])
  @@index([eventDate])
  @@index([slotId])
  @@index([updatedAt])
  @@map("catering_requests")
}

/// Ligne de sélection d'une demande. Libellés et prix figés au moment de la demande.
model CateringRequestItem {
  id             String   @id @default(uuid(7)) @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  variantId      String?  @map("variant_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(160)
  variantLabel   String   @map("variant_label") @db.VarChar(80)
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  /// Noms des parfums choisis (figés).
  flavours       String[] @default([]) @db.VarChar(120)
  position       Int      @default(0)

  request CateringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("catering_request_items")
}

/// Historique d'une demande (statut, acompte) : qui, quoi, quand.
model CateringRequestEvent {
  id         String                 @id @default(uuid(7)) @db.Uuid
  requestId  String                 @map("request_id") @db.Uuid
  fromStatus CateringRequestStatus? @map("from_status")
  toStatus   CateringRequestStatus  @map("to_status")
  actorId    String?                @map("actor_id") @db.Uuid
  note       String?                @db.VarChar(500)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  request CateringRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("catering_request_events")
}

/// Créneau de retrait ou de livraison (parcours avancé, désactivé par défaut).
model CateringSlot {
  id         String             @id @default(uuid(7)) @db.Uuid
  fulfilment CateringFulfilment
  startsAt   DateTime           @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime           @map("ends_at") @db.Timestamptz(3)
  /// Nombre maximal de commandes sur le créneau.
  capacity   Int
  active     Boolean            @default(true)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  requests CateringRequest[]

  @@index([fulfilment, startsAt])
  @@map("catering_slots")
}

// =============================================================================
// Phase 5 — Boutique
// =============================================================================

enum ShopProductKind {
  kit
  accessory

  @@map("shop_product_kind")
}

/// MLD : produit_boutique (kits d'accessoires et accessoires à l'unité).
model ShopProduct {
  id                  String          @id @default(uuid(7)) @db.Uuid
  slug                String          @unique @db.VarChar(160)
  name                String          @db.VarChar(160)
  kind                ShopProductKind
  shortDescription    String?         @map("short_description") @db.VarChar(300)
  /// Source Markdown (HTML brut désactivé) et rendu assaini, comme les articles.
  descriptionMarkdown String          @default("") @map("description_markdown")
  descriptionHtml     String          @default("") @map("description_html")
  position            Int             @default(0)
  visible             Boolean         @default(true)
  seoTitle            String?         @map("seo_title") @db.VarChar(70)
  seoDescription      String?         @map("seo_description") @db.VarChar(160)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Suppression logique : les commandes gardent leurs libellés figés.
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(3)

  variants ShopVariant[]
  kitItems ShopKitItem[]
  images   ShopProductImage[]

  @@index([kind, position])
  @@index([deletedAt])
  @@map("shop_products")
}

/// Variante vendable (référence, prix, poids). Une variante qui a un historique se désactive.
model ShopVariant {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  /// Référence unique (SKU), reprise sur les factures.
  sku         String   @unique @db.VarChar(64)
  label       String   @db.VarChar(80)
  priceCents  Int      @map("price_cents")
  /// Poids d'expédition (calcul des frais de livraison).
  weightGrams Int      @map("weight_grams")
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      ShopProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock        ShopStock?
  movements    ShopStockMovement[]
  cartItems    ShopCartItem[]
  reservations StockReservation[]

  @@index([productId, position])
  @@map("shop_variants")
}

/// MLD : stock. Disponible = en stock − réservé (paiements en cours) ; jamais négatif (CHECK).
model ShopStock {
  variantId         String    @id @map("variant_id") @db.Uuid
  onHand            Int       @default(0) @map("on_hand")
  reserved          Int       @default(0)
  lowStockThreshold Int       @default(3) @map("low_stock_threshold")
  /// Dernière alerte « stock bas » envoyée (remise à zéro au réassort).
  lowStockAlertedAt DateTime? @map("low_stock_alerted_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ShopVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("shop_stocks")
}

enum StockMovementReason {
  /// Inventaire, réassort, casse (administration).
  adjustment
  /// Vente confirmée (paiement reçu).
  sale
  /// Remise en stock après une annulation ou un remboursement.
  restock

  @@map("stock_movement_reason")
}

/// Mouvements de stock : qui, combien, pourquoi (traçabilité des écarts d'inventaire).
model ShopStockMovement {
  id        String              @id @default(uuid(7)) @db.Uuid
  variantId String              @map("variant_id") @db.Uuid
  delta     Int
  reason    StockMovementReason
  orderId   String?             @map("order_id") @db.Uuid
  actorId   String?             @map("actor_id") @db.Uuid
  note      String?             @db.VarChar(300)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ShopVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("shop_stock_movements")
}

/// MLD : composition_kit (élément, quantité). Sert aussi au tableau comparatif des kits.
model ShopKitItem {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  label     String  @db.VarChar(120)
  quantity  Int
  details   String? @db.VarChar(300)
  position  Int     @default(0)

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("shop_kit_items")
}

model ShopProductImage {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  alt       String @default("") @db.VarChar(300)
  position  Int    @default(0)

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([mediaId])
  @@map("shop_product_images")
}

enum ShippingMethod {
  delivery
  pickup
  /// Contenu numérique (packs de formation) : rien à expédier.
  digital

  @@map("shipping_method")
}

/// MLD : tarif_livraison (par zone de pays et tranche de poids ; retrait gratuit possible).
model ShippingRate {
  id             String         @id @default(uuid(7)) @db.Uuid
  name           String         @db.VarChar(120)
  method         ShippingMethod
  /// Pays desservis (ISO 3166-1 alpha-2) ; ignoré pour le retrait.
  countries      String[]       @default([]) @db.Char(2)
  minWeightGrams Int            @default(0) @map("min_weight_grams")
  /// Poids maximal inclus ; NULL = sans limite.
  maxWeightGrams Int?           @map("max_weight_grams")
  priceCents     Int            @map("price_cents")
  /// Livraison offerte à partir de ce sous-total (NULL = jamais).
  freeFromCents  Int?           @map("free_from_cents")
  /// Délai affiché (ex. « 2 à 4 jours ouvrés »).
  delay          String?        @db.VarChar(80)
  position       Int            @default(0)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([active, position])
  @@map("shipping_rates")
}

/// MLD : panier. Connecté (user_id) ou invité (empreinte du jeton du cookie).
model ShopCart {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  guestTokenHash String?  @unique @map("guest_token_hash") @db.Char(64)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShopCartItem[]

  @@index([expiresAt])
  @@map("shop_carts")
}

/// MLD : ligne_panier. Aucun prix stocké : tout est recalculé par le serveur à chaque lecture.
model ShopCartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    ShopCart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ShopVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("shop_cart_items")
}

enum OrderStatus {
  pending_payment
  paid
  preparing
  shipped
  delivered
  cancelled
  refunded

  @@map("order_status")
}

enum OrderItemKind {
  product
  /// Pack de formation (phase 7).
  pack

  @@map("order_item_kind")
}

/// MLD : commande. Coordonnées et montants figés ; conservée 10 ans avec sa facture.
model Order {
  id                   String         @id @default(uuid(7)) @db.Uuid
  /// Numéro lisible (affiché « CMD-000042 »).
  number               Int            @unique @default(autoincrement())
  status               OrderStatus    @default(pending_payment)
  userId               String?        @map("user_id") @db.Uuid
  email                String         @db.Citext
  firstName            String         @map("first_name") @db.VarChar(100)
  lastName             String         @map("last_name") @db.VarChar(100)
  phone                String?        @db.VarChar(20)
  shippingMethod       ShippingMethod @map("shipping_method")
  shippingRateName     String         @map("shipping_rate_name") @db.VarChar(120)
  /// Adresse de livraison figée (NULL pour un retrait).
  shippingAddress      Json?          @map("shipping_address")
  billingAddress       Json           @map("billing_address")
  subtotalCents        Int            @map("subtotal_cents")
  shippingCents        Int            @map("shipping_cents")
  totalCents           Int            @map("total_cents")
  refundedCents        Int            @default(0) @map("refunded_cents")
  currency             String         @default("EUR") @db.Char(3)
  carrier              String?        @db.VarChar(60)
  trackingNumber       String?        @map("tracking_number") @db.VarChar(100)
  customerNote         String?        @map("customer_note") @db.VarChar(1000)
  termsAcceptedAt      DateTime       @map("terms_accepted_at") @db.Timestamptz(3)
  termsVersion         String         @map("terms_version") @db.VarChar(20)
  /// Panier d'origine (sans clé étrangère) : une nouvelle validation du même panier annule la
  /// commande encore en attente, pour ne jamais réserver deux fois le stock.
  cartId               String?        @map("cart_id") @db.Uuid
  /// Fin de la réservation du stock (commande en attente de paiement).
  reservationExpiresAt DateTime?      @map("reservation_expires_at") @db.Timestamptz(3)
  paidAt               DateTime?      @map("paid_at") @db.Timestamptz(3)
  shippedAt            DateTime?      @map("shipped_at") @db.Timestamptz(3)
  deliveredAt          DateTime?      @map("delivered_at") @db.Timestamptz(3)
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?        @map("cancellation_reason") @db.VarChar(300)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  events       OrderEvent[]
  reservations StockReservation[]
  invoice      Invoice?
  payments     Payment[]
  refunds      Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
  @@index([cartId, status])
  @@index([reservationExpiresAt])
  @@map("orders")
}

/// MLD : ligne_commande (commander_kit, commander_pack). Libellés et prix figés à l'achat.
model OrderItem {
  id             String        @id @default(uuid(7)) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  kind           OrderItemKind @default(product)
  /// Variante vendue (sans clé étrangère : l'historique survit au catalogue).
  variantId      String?       @map("variant_id") @db.Uuid
  sku            String?       @db.VarChar(64)
  productName    String        @map("product_name") @db.VarChar(160)
  variantLabel   String        @map("variant_label") @db.VarChar(80)
  unitPriceCents Int           @map("unit_price_cents")
  quantity       Int
  weightGrams    Int           @default(0) @map("weight_grams")
  /// Pack de formation vendu (sans clé étrangère : l'historique survit au catalogue).
  packId         String?       @map("pack_id") @db.Uuid
  position       Int           @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// Historique d'une commande (statuts, expédition, annulation) : qui, quoi, quand.
model OrderEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Réservation temporaire du stock pendant le paiement (consommée au paiement, libérée à l'expiration).
model StockReservation {
  id         String    @id @default(uuid(7)) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  variantId  String    @map("variant_id") @db.Uuid
  quantity   Int
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ShopVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([orderId, variantId])
  @@index([variantId])
  @@index([expiresAt])
  @@map("stock_reservations")
}

/// Séquence des numéros de facture, une ligne par année : numérotation continue, sans trou.
model InvoiceSequence {
  year       Int @id
  lastNumber Int @default(0) @map("last_number")

  @@map("invoice_sequences")
}

/// Facture (conservée 10 ans, inaltérable : déclencheur en base). Contenu figé à l'émission.
model Invoice {
  id            String   @id @default(uuid(7)) @db.Uuid
  orderId       String   @unique @map("order_id") @db.Uuid
  /// « F-2026-00001 ».
  number        String   @unique @db.VarChar(20)
  year          Int
  sequence      Int
  issuedAt      DateTime @map("issued_at") @db.Timestamptz(3)
  /// Vendeur, acheteur et lignes figés à l'émission.
  seller        Json
  buyer         Json
  lines         Json
  subtotalCents Int      @map("subtotal_cents")
  shippingCents Int      @map("shipping_cents")
  totalCents    Int      @map("total_cents")
  /// Mention TVA (ex. « TVA non applicable, art. 293 B du CGI »).
  vatMention    String   @map("vat_mention") @db.VarChar(200)
  /// Clé du PDF dans le stockage privé (posée une seule fois par le worker).
  pdfKey        String?  @map("pdf_key") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([year, sequence])
  @@map("invoices")
}

// =============================================================================
// Phase 6 — Paiements
// =============================================================================

enum PaymentProvider {
  stripe
  paypal

  @@map("payment_provider")
}

enum PaymentStatus {
  /// Session de paiement ouverte chez le prestataire.
  pending
  succeeded
  failed
  /// Session expirée ou abandonnée par la cliente.
  abandoned
  refunded
  partially_refunded
  /// Litige ouvert par la banque de la cliente.
  disputed

  @@map("payment_status")
}

/// MLD : paiement. Aucune donnée de carte : seuls les identifiants du prestataire sont gardés.
model Payment {
  id                String          @id @default(uuid(7)) @db.Uuid
  orderId           String          @map("order_id") @db.Uuid
  provider          PaymentProvider
  status            PaymentStatus   @default(pending)
  amountCents       Int             @map("amount_cents")
  currency          String          @default("EUR") @db.Char(3)
  /// Session Stripe Checkout ou commande PayPal (unique : rapprochement des webhooks).
  providerSessionId String?         @unique @map("provider_session_id") @db.VarChar(255)
  /// PaymentIntent Stripe ou capture PayPal (remboursements).
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(255)
  /// Page de paiement hébergée chez le prestataire.
  redirectUrl       String?         @map("redirect_url") @db.VarChar(2048)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(3)
  succeededAt       DateTime?       @map("succeeded_at") @db.Timestamptz(3)
  refundedCents     Int             @default(0) @map("refunded_cents")
  failureReason     String?         @map("failure_reason") @db.VarChar(300)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId, createdAt])
  @@index([provider, status, createdAt])
  @@map("payments")
}

enum RefundStatus {
  pending
  succeeded
  failed

  @@map("refund_status")
}

/// MLD : remboursement (total ou partiel), à l'initiative de l'administration ou automatique.
model Refund {
  id               String       @id @default(uuid(7)) @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  amountCents      Int          @map("amount_cents")
  reason           String       @db.VarChar(300)
  status           RefundStatus @default(pending)
  providerRefundId String?      @unique @map("provider_refund_id") @db.VarChar(255)
  /// Articles remis en stock avec ce remboursement.
  restocked        Boolean      @default(false)
  /// NULL : remboursement automatique (stock épuisé, double paiement).
  actorId          String?      @map("actor_id") @db.Uuid
  failureReason    String?      @map("failure_reason") @db.VarChar(300)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

enum WebhookEventStatus {
  received
  processed
  ignored
  failed

  @@map("webhook_event_status")
}

/// MLD : webhook_event — idempotence (un événement du prestataire n'est traité qu'une fois).
model WebhookEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  provider    PaymentProvider
  /// Identifiant de l'événement chez le prestataire.
  eventId     String             @map("event_id") @db.VarChar(255)
  type        String             @db.VarChar(100)
  status      WebhookEventStatus @default(received)
  attempts    Int                @default(0)
  error       String?            @db.VarChar(500)
  /// Contenu vérifié (rejouable) ; purgé après 90 jours.
  payload     Json
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

// =============================================================================
// Phase 7 — Formations
// =============================================================================

/// MLD : pack_formation. Le rang ordonne les packs : un pack inclut tous les packs de rang inférieur.
model CoursePack {
  id            String   @id @default(uuid(7)) @db.Uuid
  slug          String   @unique @db.VarChar(120)
  name          String   @db.VarChar(120)
  summary       String?  @db.VarChar(500)
  priceCents    Int      @map("price_cents")
  /// 1 = Essentiel, 2 = Intermédiaire, 3 = Premium : Premium ⊇ Intermédiaire ⊇ Essentiel.
  rank          Int      @unique
  /// Contenus et avantages affichés (liste de phrases).
  features      Json     @default("[]")
  /// Appels personnalisés inclus avec ce pack.
  callsIncluded Int      @default(0) @map("calls_included")
  visible       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses  Course[]
  accesses CourseAccess[]

  @@map("course_packs")
}

enum CourseStatus {
  draft
  published

  @@map("course_status")
}

/// MLD : formation. Accessible à partir du pack indiqué (et avec tous les packs supérieurs).
model Course {
  id                  String       @id @default(uuid(7)) @db.Uuid
  slug                String       @unique @db.VarChar(160)
  title               String       @db.VarChar(200)
  summary             String       @db.VarChar(500)
  descriptionMarkdown String       @default("") @map("description_markdown")
  descriptionHtml     String       @default("") @map("description_html")
  packId              String       @map("pack_id") @db.Uuid
  coverMediaId        String?      @map("cover_media_id") @db.Uuid
  coverAlt            String       @default("") @map("cover_alt") @db.VarChar(300)
  /// Formation phare (mise en avant sur la page Formations).
  featured            Boolean      @default(false)
  status              CourseStatus @default(draft)
  position            Int          @default(0)
  seoTitle            String?      @map("seo_title") @db.VarChar(70)
  seoDescription      String?      @map("seo_description") @db.VarChar(160)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(3)

  pack         CoursePack     @relation(fields: [packId], references: [id], onDelete: Restrict)
  coverMedia   Media?         @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  modules      CourseModule[]
  lessons      Lesson[]
  certificates Certificate[]

  @@index([status, position])
  @@index([packId])
  @@index([coverMediaId])
  @@map("courses")
}

/// MLD : module.
model CourseModule {
  id        String   @id @default(uuid(7)) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String   @db.VarChar(200)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
  @@map("course_modules")
}

/// MLD : leçon (vidéo verticale, fiche PDF, conseils, quiz).
model Lesson {
  id                   String   @id @default(uuid(7)) @db.Uuid
  moduleId             String   @map("module_id") @db.Uuid
  /// Unique dans la formation (adresse de la leçon).
  slug                 String   @db.VarChar(160)
  courseId             String   @map("course_id") @db.Uuid
  title                String   @db.VarChar(200)
  summary              String?  @db.VarChar(500)
  /// Identifiant de la vidéo dans la bibliothèque Bunny Stream.
  videoId              String?  @map("video_id") @db.VarChar(100)
  videoDurationSeconds Int?     @map("video_duration_seconds")
  /// Bloc « Conseils & astuces » (Markdown assaini).
  tipsMarkdown         String   @default("") @map("tips_markdown")
  tipsHtml             String   @default("") @map("tips_html")
  /// Leçon d'exemple, consultable gratuitement sans compte.
  freePreview          Boolean  @default(false) @map("free_preview")
  published            Boolean  @default(true)
  position             Int      @default(0)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  module    CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  quiz      Quiz?
  progress  LessonProgress[]

  @@unique([courseId, slug])
  @@index([moduleId, position])
  @@map("lessons")
}

/// MLD : ressource (fiche PDF de la médiathèque, téléchargée par URL signée).
model LessonResource {
  id        String  @id @default(uuid(7)) @db.Uuid
  lessonId  String  @map("lesson_id") @db.Uuid
  mediaId   String  @map("media_id") @db.Uuid
  title     String  @db.VarChar(200)
  /// Filigrane au nom de la cliente sur chaque page.
  watermark Boolean @default(false)
  position  Int     @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  media  Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([lessonId, position])
  @@index([mediaId])
  @@map("lesson_resources")
}

/// MLD : quiz (un par leçon au plus). Correction côté serveur uniquement.
model Quiz {
  id               String   @id @default(uuid(7)) @db.Uuid
  lessonId         String   @unique @map("lesson_id") @db.Uuid
  /// Score minimal (en %) pour valider la leçon.
  passScorePercent Int      @default(70) @map("pass_score_percent")
  /// Nombre de tentatives autorisées ; NULL = illimité.
  maxAttempts      Int?     @map("max_attempts")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

/// MLD : question_quiz.
model QuizQuestion {
  id          String  @id @default(uuid(7)) @db.Uuid
  quizId      String  @map("quiz_id") @db.Uuid
  prompt      String  @db.VarChar(500)
  /// Explication montrée après la réponse.
  explanation String? @db.VarChar(1000)
  position    Int     @default(0)

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  choices QuizChoice[]

  @@index([quizId, position])
  @@map("quiz_questions")
}

/// MLD : reponse_quiz (choix proposés ; la bonne réponse n'est jamais envoyée avant validation).
model QuizChoice {
  id         String  @id @default(uuid(7)) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  label      String  @db.VarChar(300)
  isCorrect  Boolean @map("is_correct")
  position   Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, position])
  @@map("quiz_choices")
}

enum AccessSource {
  purchase
  gift
  admin

  @@map("access_source")
}

/// MLD : donner_acces (utilisateur ↔ pack).
model CourseAccess {
  id          String       @id @default(uuid(7)) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  packId      String       @map("pack_id") @db.Uuid
  source      AccessSource
  /// Commande d'achat (révocation au remboursement intégral).
  orderId     String?      @map("order_id") @db.Uuid
  grantedById String?      @map("granted_by_id") @db.Uuid
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(3)
  note        String?      @db.VarChar(300)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack CoursePack @relation(fields: [packId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([packId])
  @@index([orderId])
  @@map("course_accesses")
}

/// MLD : progresser (utilisateur ↔ leçon).
model LessonProgress {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  /// Position de lecture (reprise), en secondes.
  positionSeconds  Int       @default(0) @map("position_seconds")
  videoCompletedAt DateTime? @map("video_completed_at") @db.Timestamptz(3)
  quizBestScore    Int?      @map("quiz_best_score")
  quizPassedAt     DateTime? @map("quiz_passed_at") @db.Timestamptz(3)
  /// Leçon terminée (vidéo vue et quiz réussi s'il existe).
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// Tentative de quiz (score enregistré, limite de tentatives).
model QuizAttempt {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  quizId       String   @map("quiz_id") @db.Uuid
  scorePercent Int      @map("score_percent")
  passed       Boolean
  /// Réponses données : [{ questionId, choiceIds }].
  answers      Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@index([quizId])
  @@map("quiz_attempts")
}

/// MLD : certificat (numéro unique, vérifiable sur une page publique).
model Certificate {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// « DIANI-2026-7K3QF9XA » (aléatoire : impossible d'énumérer les titulaires).
  number      String    @unique @db.VarChar(40)
  userId      String    @map("user_id") @db.Uuid
  courseId    String    @map("course_id") @db.Uuid
  /// Nom et formation figés à l'émission.
  holderName  String    @map("holder_name") @db.VarChar(200)
  courseTitle String    @map("course_title") @db.VarChar(200)
  issuedAt    DateTime  @map("issued_at") @db.Timestamptz(3)
  pdfKey      String?   @map("pdf_key") @db.VarChar(255)
  /// Révoqué (compte supprimé, accès retiré) : la vérification publique l'indique.
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("certificates")
}

enum CallRequestStatus {
  requested
  scheduled
  done
  cancelled

  @@map("call_request_status")
}

/// Avantage des packs : demande d'appel personnalisé (nombre d'appels limité par les packs).
model CallRequest {
  id          String            @id @default(uuid(7)) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  status      CallRequestStatus @default(requested)
  /// Disponibilités et sujet indiqués par la cliente.
  message     String            @db.VarChar(2000)
  scheduledAt DateTime?         @map("scheduled_at") @db.Timestamptz(3)
  adminNote   String?           @map("admin_note") @db.VarChar(1000)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("call_requests")
}

// =============================================================================
// Phase 8 — Contact et newsletter
// =============================================================================

enum ContactSubject {
  general
  catering
  courses
  shop
  partnership
  other

  @@map("contact_subject")
}

enum ContactStatus {
  new
  read
  answered
  archived

  @@map("contact_status")
}

/// MLD : contact_message. Supprimé un an après la dernière activité.
model ContactMessage {
  id        String         @id @default(uuid(7)) @db.Uuid
  name      String         @db.VarChar(120)
  email     String         @db.Citext
  phone     String?        @db.VarChar(20)
  subject   ContactSubject @default(general)
  message   String         @db.VarChar(5000)
  status    ContactStatus  @default(new)
  /// Note interne de l'administration.
  adminNote String?        @map("admin_note") @db.VarChar(2000)
  handledAt DateTime?      @map("handled_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([email])
  @@index([updatedAt])
  @@map("contact_messages")
}

enum NewsletterStatus {
  /// Inscription demandée, confirmation par e-mail attendue (double opt-in).
  pending
  confirmed
  unsubscribed

  @@map("newsletter_status")
}

enum NewsletterSource {
  /// Formulaire du site (double opt-in par e-mail).
  form
  /// Case cochée dans le compte (adresse déjà vérifiée).
  account

  @@map("newsletter_source")
}

/// MLD : abonne_newsletter. Preuve du consentement : texte accepté, dates, IP tronquées.
model NewsletterSubscriber {
  id                    String           @id @default(uuid(7)) @db.Uuid
  email                 String           @unique @db.Citext
  status                NewsletterStatus @default(pending)
  source                NewsletterSource @default(form)
  /// Texte du consentement tel qu'affiché à l'inscription.
  consentText           String           @map("consent_text") @db.VarChar(500)
  requestedAt           DateTime         @map("requested_at") @db.Timestamptz(3)
  requestIpTruncated    String?          @map("request_ip_truncated") @db.VarChar(64)
  /// Empreinte du jeton de confirmation (usage unique, 7 jours).
  confirmTokenHash      String?          @unique @map("confirm_token_hash") @db.Char(64)
  confirmTokenExpiresAt DateTime?        @map("confirm_token_expires_at") @db.Timestamptz(3)
  confirmedAt           DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  confirmIpTruncated    String?          @map("confirm_ip_truncated") @db.VarChar(64)
  unsubscribedAt        DateTime?        @map("unsubscribed_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, confirmedAt])
  @@index([updatedAt])
  @@map("newsletter_subscribers")
}
