# Configuration des tests e2e — valeurs locales sans secret réel (infrastructure docker-compose.test.yml).
NODE_ENV=test
PUBLIC_SITE_URL=http://localhost:5173
# L'API se connecte avec le rôle à privilèges minimaux, comme en production ; les migrations
# (test/e2e/global-setup.ts) avec le rôle propriétaire.
DATABASE_URL=postgresql://diani_app:diani_app_test_password@127.0.0.1:55432/diani_test?schema=public&connection_limit=5
MIGRATION_DATABASE_URL=postgresql://diani:diani_test_password@127.0.0.1:55432/diani_test?schema=public
REDIS_URL=redis://127.0.0.1:56379
LOG_LEVEL=silent
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=1000
# Les tests simulent des clients distincts via X-Forwarded-For (limitation de débit par IP).
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=test-only-jwt-secret-0123456789-abcdefghijkl
FIELD_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=tmp/mails-test
S3_ENDPOINT=http://127.0.0.1:58333
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test-secret
S3_BUCKET_PRIVATE=diani-test-private
S3_BUCKET_PUBLIC=diani-test-public
S3_AUTO_CREATE_BUCKETS=true
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:58333/diani-test-public
CONTENT_CACHE_TTL_SECONDS=300
# Paiements : clés factices, les appels aux prestataires passent par un faux serveur (tests e2e).
STRIPE_SECRET_KEY=sk_test_e2e0123456789
STRIPE_WEBHOOK_SECRET=whsec_e2e0123456789
PAYPAL_CLIENT_ID=paypal-e2e-client
PAYPAL_CLIENT_SECRET=paypal-e2e-secret
PAYPAL_WEBHOOK_ID=WH-E2E-0001
PAYPAL_ENVIRONMENT=sandbox
