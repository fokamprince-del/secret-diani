# Copier en demo/.env.demo (jamais commité). Tout est facultatif.

# Connexion avec Google : console Google Cloud → API et services → Identifiants →
# « Créer des identifiants » → ID client OAuth → Application Web.
# URI de redirection autorisée : affichée au lancement de la démo (elle change à chaque fois).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envoi réel des e-mails (confirmation d'inscription, mot de passe oublié) via Resend.
# Sans clé, les e-mails sont seulement écrits dans backend/tmp/mails.
RESEND_API_KEY=
# MAIL_FROM="Les Secrets de Diani <ne-pas-repondre@votre-domaine-verifie.fr>"
